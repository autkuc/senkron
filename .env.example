# ==============================================
# Senkron Environment Configuration Template
# ==============================================

# Node Environment
NODE_ENV=production

# Web Demo Port & Host
PORT=3000
HOSTNAME=0.0.0.0

# Backend Service URL (for Next.js server actions / proxy)
BACKEND_URL=http://localhost:4000
BACKEND_PORT=4000

# Modal Serverless GPU / LLM Endpoint
# Example: https://arapronaldosui--senkron-llm-service-serve.modal.run/v1/chat/completions
MODAL_LLM_ENDPOINT=

# Local Ollama / vLLM Fallback Endpoint
LOCAL_LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
